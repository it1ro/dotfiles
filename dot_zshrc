# ============================
#  mise shims — должны быть первыми
# ============================
export PATH="$HOME/.local/share/mise/shims:$PATH"

# ============================
#  Powerlevel10k instant prompt
# ============================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================
#  mise activation
# ============================
eval "$(mise activate zsh)"

# ============================
#  Базовое окружение
# ============================
export LIBVA_DRIVER_NAME=iHD
export OLLAMA_HOST=127.0.0.1:11434
export EDITOR=nvim

# ============================
#  PATH
# ============================
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Flutter
export PATH="$PATH:$HOME/.bin/flutter/bin"

# Android SDK
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"

# Chrome
export CHROME_EXECUTABLE=google-chrome-stable

# ============================
#  История Zsh
# ============================
setopt PROMPT_SUBST
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS

HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history

# ============================
#  Функции
# ============================
copy-last-output() {
  local last_cmd=$(fc -ln -1 | sed 's/^[[:space:]]*//')
  eval "$last_cmd" | wl-copy
  echo "Вывод '$last_cmd' скопирован"
}

cattext() {
  find . -type f -exec sh -c '
    for f; do
      if file -b "$f" | grep -q "text"; then
        printf "\n--- %s ---\n" "$f"
        cat "$f"
      fi
    done
  ' sh {} +
}

# ============================
#  Плагины
# ============================

# fzf
if (( $+commands[fzf] )); then
  source /usr/share/fzf/key-bindings.zsh
  source /usr/share/fzf/completion.zsh
  export FZF_COMPLETION_TRIGGER='~~'
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --info=inline'
fi

# zoxide
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# autosuggestions
if (( $+commands[zsh-autosuggestions] )); then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# ============================
#  Комплиты
# ============================
autoload -Uz compinit && compinit

# ============================
#  Powerlevel10k
# ============================
source "$HOME/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ============================
#  JetBrains VM options
# ============================
[[ -f "$HOME/.jetbrains.vmoptions.sh" ]] && source "$HOME/.jetbrains.vmoptions.sh"

# ============================
#  TMUX автозапуск
# ============================
if [[ -z "$TMUX" ]] && [[ "$TERM_PROGRAM" != "vscode" ]] && (( $+commands[tmux] )); then
  if tmux has-session 2>/dev/null; then
    exec tmux attach-session -d
  else
    exec tmux new-session
  fi
fi

# ============================
#  Functions
# ============================
xx() { chmod +x "$1" && echo "исполняемый: $1" }
rr() { source ~/.zshrc && echo "zshrc обновлён" }

# ============================
