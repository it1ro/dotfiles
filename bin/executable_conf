#!/usr/bin/env ruby

require 'pathname'
require 'shellwords'
require 'io/console'
require 'stringio'

DRY_RUN = ARGV.include?('--dry') || ARGV.include?('-n')
NO_LESS = ARGV.include?('--no-less')

TARGETS = [
  "#{ENV['HOME']}/.zshrc",
  "#{ENV['HOME']}/.tmux.conf",
  "#{ENV['HOME']}/.zsh",
  "#{ENV['HOME']}/.tmux",
  "#{ENV['HOME']}/.config/alacritty"
]

SKIP_EXT = %w[
  .txt .md .html .htm .rst .log .csv .json
  .png .jpg .jpeg .gif .svg .webp .ico .bmp
]

SKIP_DIRS = %w[
  .git plugins tpm alias-tips screenshots docs video test tests
]

def header(title)
  puts "\n\e[36m===== #{title} =====\e[0m"
end

def subheader(title)
  puts "\e[33m--- #{title} ---\e[0m"
end

def text_file?(path)
  escaped = Shellwords.shellescape(path)
  mime = `file --mime-type -b #{escaped}`.strip
  mime.start_with?('text/')
end

def skip_dir?(path)
  SKIP_DIRS.any? { |d| path.to_s.split('/').include?(d) }
end

def build_tree(paths, root)
  tree = {}

  paths.each do |full|
    rel = full.sub("#{root}/", '')
    parts = rel.split('/')

    cursor = tree
    parts.each_with_index do |part, idx|
      if idx == parts.size - 1
        cursor[part] = nil
      else
        cursor[part] ||= {}
        cursor = cursor[part]
      end
    end
  end

  tree
end

def print_tree(tree, prefix = '')
  keys = tree.keys.sort
  keys.each_with_index do |key, idx|
    last   = (idx == keys.size - 1)
    branch = last ? '└── ' : '├── '
    puts "#{prefix}#{branch}#{key}"

    if tree[key].is_a?(Hash)
      new_prefix = prefix + (last ? '    ' : '│   ')
      print_tree(tree[key], new_prefix)
    end
  end
end

# Буфер для вывода (dry-run и normal)
buffer = StringIO.new
$stdout = buffer

TARGETS.each do |raw_path|
  path = Pathname.new(raw_path)

  header(path.to_s)

  if DRY_RUN
    files_to_read = []

    if path.file?
      files_to_read << path.to_s
    elsif path.directory?
      path.find do |file|
        next if skip_dir?(file)
        next unless file.file?
        next unless text_file?(file.to_s)
        next if SKIP_EXT.include?(file.extname.downcase)

        files_to_read << file.to_s
      end
    else
      puts 'Путь не найден'
      next
    end

    subheader('Найденные конфигурационные файлы')
    if files_to_read.empty?
      puts '(нет конфигурационных файлов)'
    else
      root = path.to_s
      tree = build_tree(files_to_read, root)
      print_tree(tree)
    end

    subheader('Будут прочитаны')
    files_to_read.each { |f| puts "- #{f}" }

    next
  end

  # NORMAL MODE
  files_to_read = []

  if path.file?
    files_to_read << path.to_s
  elsif path.directory?
    path.find do |file|
      next if skip_dir?(file)
      next unless file.file?
      next unless text_file?(file.to_s)
      next if SKIP_EXT.include?(file.extname.downcase)

      files_to_read << file.to_s
    end
  else
    puts 'Путь не найден.'
    next
  end

  if files_to_read.empty?
    subheader('Нет файлов для чтения')
    next
  end

  subheader('ФАЙЛЫ ВНУТРИ')
  files_to_read.each do |file_path|
    puts "\n\e[32m>>> #{file_path}\e[0m"
    File.foreach(file_path) do |line|
      next if line.lstrip.start_with?('#')

      print line
    end
  end
end

# Восстанавливаем stdout
$stdout = STDOUT
result = buffer.string

# Если пользователь запретил less
if NO_LESS
  print result
  exit 0
end

# Авто-less
lines = result.lines.count
rows  = begin
  IO.console.winsize[0]
rescue StandardError
  24
end

if lines > rows - 5
  IO.popen('less -R', 'w') { |io| io.write(result) }
else
  print result
end
