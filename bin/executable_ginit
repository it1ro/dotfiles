#!/bin/bash

# ginit.sh — initialize a new GitHub project with git-flow structure
# Usage: ./ginit.sh <project-name>

if [ -z "$1" ]; then
  echo "Usage: $0 <project-name>"
  exit 1
fi

# Check if gh is installed
if ! command -v gh >/dev/null 2>&1; then
  echo "Error: GitHub CLI (gh) is not installed."
  echo "Install it: https://cli.github.com/"
  exit 1
fi

# Check if gh is authenticated
if ! gh auth status >/dev/null 2>&1; then
  echo "Error: gh is installed but not authenticated."
  echo "Run: gh auth login"
  exit 1
fi

PROJECT="$1"

echo "📁 Creating project directory: $PROJECT"
mkdir "$PROJECT" || exit 1
cd "$PROJECT" || exit 1

echo "🔧 Initializing git repository..."
git init -b main

echo "# $PROJECT" > README.md
git add README.md
git commit -m "first commit"

echo "🌐 Creating GitHub repository..."
gh repo create "$PROJECT" --public --source=. --remote=origin --push

echo "🌿 Creating develop branch..."
git checkout -b develop
git push -u origin develop

echo "🛡 Running protect-branches.sh (if available)..."

if command -v protect-branches.sh >/dev/null 2>&1; then
  protect-branches.sh
elif [ -f "../protect-branches.sh" ]; then
  ../protect-branches.sh
elif [ -f "./protect-branches.sh" ]; then
  ./protect-branches.sh
else
  echo "⚠️ protect-branches.sh not found. Skipping hook installation."
fi

echo "✅ Project '$PROJECT' initialized with git-flow and branch protection."
